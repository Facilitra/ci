#!/usr/bin/env bash
# Fake kubectl for the tests. Appends "kubectl <args...>" to $FAKE_LOG and answers
# from canned files in $FAKE_DIR (default $TMP/fake). A missing file means the
# default behaviour: no output, exit 0 (see each verb for the exceptions).
#
#   apply            dryrun-out dryrun-rc   (with --dry-run=server)
#                    apply-out  apply-rc    (real apply)
#   delete           delete-out delete-rc
#   rollout status   rollout-out.<name> rollout-rc.<name> rollout-sleep.<name>
#   get job/<n>      job-status: one line per call, conditions joined by ';'
#                    (the last line repeats); e.g. "" / "Complete=True"
#   get ... readinessProbe   noprobe.<name>    container names without a probe
#   get ... matchLabels      selector.<name>   "app=x,tier=y,"
#   get pods -o jsonpath     pods              space separated pod names
#   get pod <p> ... initContainers   containers.<p>   container names
#   get events       events
#   get <other>      get.<resource with / as _>
#   describe <...>   describe.<args joined by _>   (default: a "FAKE describe" line)
#   logs <pod|job/n|-l> [-c c] [--previous]   logs.<pod>.<c>[.previous]
#   version          version-out (default "Client Version: v1.31.4"), version-server,
#                    version-rc (exit code of `version --client`, to simulate a binary that does not run)
set -u
FAKE_DIR=${FAKE_DIR:-${TMP:-/tmp}/fake}

if [[ -n ${FAKE_LOG:-} ]]; then
  line=kubectl
  for a in "$@"; do line+=" $a"; done
  printf '%s\n' "$line" >> "$FAKE_LOG"
fi

emit() { if [[ -f $FAKE_DIR/$1 ]]; then cat "$FAKE_DIR/$1"; return 0; fi; return 1; }
rc_of() { if [[ -f $FAKE_DIR/$1 ]]; then tr -d '[:space:]' < "$FAKE_DIR/$1"; else echo "${2:-0}"; fi; }

verb=${1:-}
[[ $# -gt 0 ]] && shift
all=("$@")
has_arg() { local a; for a in "${all[@]}"; do [[ $a == *"$1"* ]] && return 0; done; return 1; }

# positional words and the value of -c
pos=()
container=''
skip=0
prev=''
for a in "${all[@]}"; do
  if [[ $skip -eq 1 ]]; then
    skip=0
    [[ $prev == -c ]] && container=$a
    continue
  fi
  case $a in
    -n | -l | -o | -c | -f | -p)
      skip=1
      prev=$a
      ;;
    -*) ;;
    *) pos+=("$a") ;;
  esac
done
key() { local IFS=_; local k="$*"; echo "${k//\//_}"; }

case $verb in
  apply)
    if has_arg --dry-run=server; then
      emit dryrun-out
      exit "$(rc_of dryrun-rc)"
    fi
    emit apply-out
    exit "$(rc_of apply-rc)"
    ;;
  delete)
    emit delete-out
    exit "$(rc_of delete-rc)"
    ;;
  rollout)
    if [[ ${pos[0]:-} == status ]]; then
      name=${pos[1]#*/}
      kind=${pos[1]%%/*}
      echo "Waiting for $kind \"$name\" rollout to finish..."
      if [[ -f $FAKE_DIR/rollout-sleep.$name ]]; then
        exec sleep "$(cat "$FAKE_DIR/rollout-sleep.$name")"
      fi
      rc=$(rc_of "rollout-rc.$name")
      if ! emit "rollout-out.$name"; then
        if [[ $rc -eq 0 ]]; then
          echo "$kind \"$name\" successfully rolled out"
        else
          echo "error: $kind \"$name\" exceeded its progress deadline"
        fi
      fi
      exit "$rc"
    fi
    exit 0
    ;;
  get)
    res=${pos[0]:-}
    name=${res#*/}
    if has_arg matchLabels; then
      emit "selector.$name"
    elif has_arg readinessProbe; then
      emit "noprobe.$name"
    elif has_arg initContainers; then
      emit "containers.${pos[1]:-}"
    elif [[ $res == job/* ]]; then
      f=$FAKE_DIR/job-status
      if [[ -f $f ]]; then
        n=0
        [[ -f $FAKE_DIR/.job-n ]] && n=$(cat "$FAKE_DIR/.job-n")
        total=$(grep -c '' "$f")
        idx=$((n + 1))
        [[ $idx -gt $total ]] && idx=$total
        out=''
        [[ $idx -gt 0 ]] && out=$(sed -n "${idx}p" "$f")
        echo $((n + 1)) > "$FAKE_DIR/.job-n"
        [[ -n $out ]] && printf '%s\n' "${out//;/$'\n'}"
      fi
    elif [[ $res == pods && $* == *metadata.name* ]]; then
      emit pods
    elif [[ $res == events ]]; then
      emit events
    else
      emit "get.$(key "$res")"
    fi
    exit 0
    ;;
  describe)
    emit "describe.$(key "${pos[@]}")" || echo "FAKE describe ${pos[*]}"
    exit 0
    ;;
  logs)
    k="logs.$(key "${pos[@]:-sel}")"
    [[ -n $container ]] && k+=".$container"
    if has_arg --previous; then
      emit "$k.previous" && exit 0
      echo "error: previous terminated container not found" >&2
      exit 1
    fi
    emit "$k" || echo "FAKE logs ${pos[*]:-selector} ${container}"
    exit 0
    ;;
  version)
    if has_arg --client && [[ -f $FAKE_DIR/version-rc ]]; then
      echo "kubectl: cannot execute binary file" >&2
      exit "$(rc_of version-rc)"
    fi
    if [[ -f $FAKE_DIR/version-out ]]; then cat "$FAKE_DIR/version-out"; else echo "Client Version: v1.31.4"; fi
    if ! has_arg --client; then
      if [[ -f $FAKE_DIR/version-server ]]; then
        echo "Server Version: $(cat "$FAKE_DIR/version-server")"
      else
        echo "Unable to connect to the server" >&2
        exit 1
      fi
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
